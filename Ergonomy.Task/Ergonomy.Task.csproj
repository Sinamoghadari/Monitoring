<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ergonomy.Task - interactive (user session) process.

    Owns only what needs the interactive desktop: low-level input hooks, ActivityMonitor
    and alarm forms. Named Pipe CLIENT. Never talks to Kafka, SQLite, Postgres or the
    Settings API — Ergonomy.Service is the only owner of those.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ergonomy.TaskAgent</RootNamespace>
    <AssemblyName>Ergonomy.Task</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ergonomy.Core\Ergonomy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Hooks\GlobalInputHook.cs" Link="Hooks\GlobalInputHook.cs" />
    <Compile Include="..\Hooks\ActivityMonitor.cs" Link="Hooks\ActivityMonitor.cs" />
    <Compile Include="..\AlarmManager.cs" Link="AlarmManager.cs" />
    <Compile Include="..\UI\PrimaryAlarmForm.cs" Link="UI\PrimaryAlarmForm.cs" />
    <Compile Include="..\UI\PrimaryAlarmForm.Designer.cs" Link="UI\PrimaryAlarmForm.Designer.cs" />
    <Compile Include="..\UI\SecondaryAlarmForm.cs" Link="UI\SecondaryAlarmForm.cs" />
    <Compile Include="..\UI\SecondaryAlarmForm.Designer.cs" Link="UI\SecondaryAlarmForm.Designer.cs" />
    <Compile Include="..\UI\MessageAlarmForm.cs" Link="UI\MessageAlarmForm.cs" />
  </ItemGroup>

</Project>
