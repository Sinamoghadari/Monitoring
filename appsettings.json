{
  "AppSettings": {


    // اجازه برای اجرا کردن برنامه ارگونومی
    "AllowErgonomyCollection": true,
    
    // تایمر برای چک کردن تنظیمات از Postgres
    "SettingsCheckIntervalSeconds" : 30 ,

    // فاصله زمانی بررسی وضعیت کاربر (ثانیه). اگر کاربر بیشتر از ActivityThreshold بیکار بود، آلارم فعال می‌شود.
    "NotificationIntervalSeconds": 5,
    
    // مدت زمان کارکرد برای ارسال آلارم به کاربر
    "ActivityThresholdSeconds": 5,
    
    // مدت زمانی(ثانیه) که نیاز است که آلارم دوم بصورت اتوماتیک بسته شود 
    "PrimaryAlarmAutoCloseSeconds": 7,
    
    // تعداد دفعاتی که نیاز است آلارم اول بسته شود تا آلارم دوم فعال شود
    "SessionCloseLimit": 3,
    
    // مدت زمانی که آلارم دوم قفل است و کاربر نمی‌تواند آن را ببندد (ثانیه)
    "SecondaryAlarmUnclosableSeconds": 10,
    
    // زمان بسته شدن خودکار آلارم ثانویه پس از پایان یافتن زمان قفل (ثانیه)
    "SecondaryAlarmAutoCloseSeconds": 7,
    
    // فاصله زمانی ثبت لاگ‌ها در دیتابیس (ساعت)
    "LoggingIntervalHours": 1,
    
    // فاصله زمانی جمع‌آوری اطلاعات سخت افزاری (دقیقه)
    "AdvancedMetricsIntervalMinutes": 0.1, 
    // چک کردن دستورات باز کردن پنجره مسیج به کاربر (ثانیه)
    "CommandCheckIntervalSeconds" : 30 ,

    // فاصله زمانی سینک بین اس کیو لایت و کافکا (دقیقه)
    "SyncEngineIntervalMinutes": 1,
    
    // تعداد برنامه‌های پرمصرف که باید استخراج شوند (برای رم و سی‌پی‌یو)
    "TopProcessesCount": 10, 
    
    // اجازه برای چک کردن دیتابیس postgres
    "CheckPostgresConnection": true,

    // آی‌پی مقصدی که برای بررسی وضعیت شبکه (Tracert) پینگ می‌شود
    "NetworkTraceTargetIP": "172.17.214.1",

    // اجازه ارسال داده های به sqlite
    "AllowSqliteWrite": true,

    // چک کردن دوباره اجازه برای ارسال داده های به Sqlite

    "PermissionSqliteRetryIntervalHours": 0.1,

    // اجازه برای ارسال داده ها به کافکا
    "AllowKafkaWrite": true,

    // چک کردن دوباره برای ارسال داده ها به kafka
    "PermissionKafkaRetryIntervalHours": 0.1,

    // زمان خواب برنامه درصورت اجازه ندادن به کار کردن (دقیقه)
    "ConnectionFailureSleepMinutes": 5,

    //  اطلاعات کافکا
    "Kafka": {
    "BootstrapServers": "172.17.214.28:9092",
    "UserActivityTopic": "user_activity_topic",
    "SystemMetricsTopic": "advanced_system_metrics_topic"
    } ,

    // شاخص هایی که نیاز به جمع آوری آنها می یاشد
    "EnabledMetrics": [
      "WindowsSid", "WindowsUsername", "BootTime", "SystemUptimeSeconds", 
      "FailedLoginAttempts", "AntivirusStatus", "FirewallStatus", "UsbDevicesCount", 
      "MotherboardSerial", "ActiveProcesses", "ActiveThreads", "OpenHandles", 
      "NetworkTrace", "DiskModels", "TopProcesses", "CpuUsagePercent", 
      "LogicalCores", "PhysicalCores", "CpuTemperature", "TotalRamMb", 
      "UsedRamMb", "FreeRamMb", "StorageDetails", "NetworkDetails" , "ComputerName" ,
      "DiskHealthStatus" , "CriticalSystemEvents"
    ],

    // اطلاعات دیتابیس postgres
    "Database": {
      // تنظیمات اتصال به دیتابیس PostgreSQL
      "Host": "172.17.214.28",
      "Port": 6543,
      "Name": "Monitoring",
      "User": "postgres",
      "Password": "Root_2118908",
      "Schema": "public",
      "Table": "user_activity"
    },
    "Images": {
      // مسیر تصاویر آلارم‌ها برای حالت آفلاین
      "PrimaryAlarmImagePath": "Assets/primary_alarm.png",
      "SecondaryAlarmImagePath": "Assets/secondary_alarm.png"
    }
  }
}
